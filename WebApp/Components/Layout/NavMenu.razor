@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<aside class="sidebar @(isCollapsed ? "sidebar-collapsed" : string.Empty)">
    <div class="sidebar-brand" title="UrlTrimmer">
        <span class="brand-mark">U</span>
        <span class="sidebar-label">UrlTrimmer</span>
    </div>

    <button type="button" class="sidebar-toggle"
            aria-label="@(isCollapsed ? "Expand navigation" : "Collapse navigation")" aria-expanded="@(!isCollapsed)"
            title="@(isCollapsed ? "Expand navigation" : "Collapse navigation")" @onclick="ToggleSidebar">
        <span aria-hidden="true">@(isCollapsed ? "→" : "←")</span>
        <span class="sidebar-label">@(isCollapsed ? "Expand" : "Collapse")</span>
    </button>

    <nav class="navmenu" aria-label="Main navigation">
        <a href="/dashboard" class="navlink" title="Dashboard"><span class="nav-icon" aria-hidden="true">⌂</span><span
            class="sidebar-label">Dashboard</span></a>

            @if (isSignedIn)
            {
                <a href="/" class="navlink" title="Links"><span class="nav-icon" aria-hidden="true">↗</span><span
                    class="sidebar-label">Links</span></a>
                    <span class="nav-user"><span class="nav-avatar">@displayName[..1].ToUpperInvariant()</span><span
                        class="sidebar-label">@displayName</span></span>
                        <button type="button" class="navlink navbutton" title="Log out" onclick="window.urlTrimmerClerk.signOut()"><span
                            class="nav-icon" aria-hidden="true">↪</span><span class="sidebar-label">Log out</span></button>
                        }
        else
                        {
                            <button type="button" class="navlink navbutton" title="Sign in"
                                    onclick="window.urlTrimmerClerk.openSignIn()"><span class="nav-icon" aria-hidden="true">→</span><span
                                class="sidebar-label">Sign in</span></button>
                                <button type="button" class="navlink navbutton" title="Sign up"
                                        onclick="window.urlTrimmerClerk.openSignUp()"><span class="nav-icon" aria-hidden="true">+</span><span
                                    class="sidebar-label">Sign up</span></button>
                                }
                            </nav>
                        </aside>

@code {
    private DotNetObjectReference<NavMenu>? dotNetReference;
    private bool isSignedIn;
    private bool isCollapsed = true;
    private string displayName = "User";

    private void ToggleSidebar() => isCollapsed = !isCollapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetReference = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.registerAuthStateListener", dotNetReference);
            var authState = await JSRuntime.InvokeAsync<AuthState>("urlTrimmerClerk.getAuthState");
            ApplyAuthState(authState);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            isSignedIn = false;
            displayName = "User";
        }
    }

    [JSInvokable]
    public Task OnAuthStateChanged(AuthState authState)
    {
        ApplyAuthState(authState);
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyAuthState(AuthState authState)
    {
        isSignedIn = authState.IsSignedIn;
        displayName = string.IsNullOrWhiteSpace(authState.DisplayName) ? "User" : authState.DisplayName;
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetReference is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.unregisterAuthStateListener", dotNetReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        dotNetReference.Dispose();
        dotNetReference = null;
    }

    public sealed record AuthState(bool IsSignedIn, string DisplayName);
}
