@page "/dashboard"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard - UrlTrimmer</PageTitle>

<section class="hero hero-single">
    <div>
        <p class="eyebrow">Overview</p>
        <h2>Everything UrlTrimmer does for your links</h2>
        <p class="lede">
            UrlTrimmer turns long URLs into short, shareable links and keeps every link organized in one place.
        </p>
    </div>
</section>

@if (isSignedIn)
{
    <section class="card">
        <h3>Your links</h3>
        @if (!linksLoaded)
        {
            <p class="muted">Loading your links...</p>
        }
        else if (loadError is not null)
        {
            <p class="error-banner">We couldn't load your links right now. Please try again later.</p>
        }
        else if (urls.Count == 0)
        {
            <p class="muted">You haven't created any links yet.</p>
        }
        else
        {
            <ul class="url-list">
                @foreach (var url in urls)
                {
                    <li>
                        <strong><a href="@url.ShortenedUrl" target="_blank">@url.Code</a></strong>
                        <span>@url.OriginalUrl</span>
                        <small>Created @url.CreatedAt</small>
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="results-grid">
    <article class="card">
        <h3>Shorten instantly</h3>
        <p class="muted">Paste any long URL and get a compact, shareable link in seconds, with an optional custom code.
        </p>
    </article>

    <article class="card">
        <h3>Custom short codes</h3>
        <p class="muted">Use an auto-generated code or supply your own memorable custom code when you shorten a link.
        </p>
    </article>

    <article class="card">
        <h3>Stay organized</h3>
        <p class="muted">All your saved links live in one place, ready to revisit, share again, or hand off to
            teammates.</p>
        </article>

        <article class="card">
            <h3>Secure sign-in</h3>
            <p class="muted">Sign in with Clerk to create and manage your own links safely.</p>
        </article>
    </section>

@code {
    private readonly List<ShortUrlViewModel> urls = [];
    private bool isSignedIn;
    private bool linksLoaded;
    private string clerkUserId = string.Empty;
    private Exception? loadError;
    private DotNetObjectReference<Dashboard>? dotNetReference;

    [Inject]
    private UrlShortenerApiClient ApiClient { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetReference = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.registerAuthStateListener", dotNetReference);
            var authState = await JSRuntime.InvokeAsync<AuthState>("urlTrimmerClerk.getAuthState");
            await ApplyAuthStateAsync(authState);
        }
        catch (JSException)
        {
            isSignedIn = false;
        }
    }

    [JSInvokable]
    public Task OnAuthStateChanged(AuthState authState) => ApplyAuthStateAsync(authState);

    private async Task ApplyAuthStateAsync(AuthState authState)
    {
        var userChanged = !string.Equals(clerkUserId, authState.UserId, StringComparison.Ordinal);
        isSignedIn = authState.IsSignedIn;
        clerkUserId = authState.UserId;

        if (!isSignedIn)
        {
            urls.Clear();
            linksLoaded = false;
            loadError = null;
        }
        else if (userChanged || !linksLoaded)
        {
            try
            {
                var items = await ApiClient.GetUrlsAsync(clerkUserId);
                urls.Clear();
                urls.AddRange(items);
                loadError = null;
            }
            catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
            {
                loadError = exception;
            }

            linksLoaded = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetReference is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.unregisterAuthStateListener", dotNetReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        dotNetReference.Dispose();
        dotNetReference = null;
    }

    public sealed record AuthState(bool IsSignedIn, string DisplayName, string UserId);
}