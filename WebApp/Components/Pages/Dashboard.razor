@page "/dashboard"

<PageTitle>Dashboard - UrlTrimmer</PageTitle>

<section class="hero hero-single">
    <div>
        <p class="eyebrow">Overview</p>
        <h2>Everything UrlTrimmer does for your links</h2>
        <p class="lede">
            UrlTrimmer turns long URLs into short, shareable links and keeps every link organized in one place.
        </p>
    </div>
</section>

<section class="results-grid">
    <article class="card">
        <h3>Shorten instantly</h3>
        <p class="muted">Paste any long URL and get a compact, shareable link in seconds, with an optional custom code.
        </p>
    </article>

    <article class="card">
        <h3>Custom short codes</h3>
        <p class="muted">Use an auto-generated code or supply your own memorable custom code when you shorten a link.
        </p>
    </article>

    <article class="card">
        <h3>Stay organized</h3>
        <p class="muted">All your saved links live in one place, ready to revisit, share again, or hand off to
            teammates.</p>
        </article>

        <article class="card">
            <h3>Secure sign-in</h3>
            <p class="muted">Sign in with Clerk to create and manage your own links safely.</p>
        </article>
    </section>