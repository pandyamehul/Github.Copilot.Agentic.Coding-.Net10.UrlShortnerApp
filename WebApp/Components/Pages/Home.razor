@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>UrlTrimmer</PageTitle>

@if (!isSignedIn)
{
    <section class="hero hero-single">
        <div>
            <p class="eyebrow">Link shortening</p>
            <h2>Trim a long URL and keep the important part.</h2>
            <p class="lede">
                UrlTrimmer turns long URLs into short, shareable links and keeps every link organized
                in one place. Sign in to start creating your own.
            </p>
        </div>
    </section>

    <section class="results-grid">
        <article class="card">
            <h3>Shorten instantly</h3>
            <p class="muted">Paste any long URL and get a compact, shareable link in seconds, with an optional custom code.
            </p>
        </article>

        <article class="card">
            <h3>Custom short codes</h3>
            <p class="muted">Use an auto-generated code or supply your own memorable custom code when you shorten a
                link.</p>
            </article>

            <article class="card">
                <h3>Stay organized</h3>
                <p class="muted">All your saved links live in one place, ready to revisit, share again, or hand off to
                    teammates.</p>
                </article>

                <article class="card">
                    <h3>Secure sign-in</h3>
                    <p class="muted">Sign in with Clerk to create and manage your own links safely.</p>
                </article>
            </section>
        }
else
        {
            <section class="hero">
                <div>
                    <p class="eyebrow">Link shortening</p>
                    <h2>Trim a long URL and keep the important part.</h2>
                    <p class="lede">
                        Create compact links and manage your saved URLs, all backed by the API-powered URL store.
                    </p>
                </div>

                <EditForm Model="request" OnValidSubmit="CreateShortUrlAsync" class="card form-card">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (createError is not null)
                    {
                        <p class="error-banner">@createError</p>
                    }

                    <label>
                        Original URL
                        <InputText @bind-Value="request.OriginalUrl" placeholder="https://example.com/products/very-long-path" />
                    </label>

                    <label>
                        Custom code
                        <InputText @bind-Value="request.CustomCode" placeholder="optional-custom-code" />
                    </label>

                    <button type="submit" disabled="@isSubmitting">@submitLabel</button>
                </EditForm>
            </section>

            <section class="results-grid">
                <article class="card">
                    <div class="section-heading compact-heading">
                        <div>
                            <p class="eyebrow">Just created</p>
                            <h3>Latest link</h3>
                        </div>
                    </div>
                    @if (latestLink is null)
                    {
                        <div class="empty-state">
                            <span class="empty-state-icon" aria-hidden="true">↗</span>
                            <p>No shortened link yet.</p>
                            <small>Your next shortened URL will appear here.</small>
                        </div>
                    }
                    else
                    {
                        <div class="result-block">
                            <a href="@latestLink.ShortenedUrl" target="_blank">@latestLink.ShortenedUrl</a>
                            <p>@latestLink.OriginalUrl</p>
                            <small>Created @latestLink.CreatedAt</small>
                        </div>
                    }
                </article>

                <article class="card">
                    <div class="section-heading compact-heading">
                        <div>
                            <p class="eyebrow">Your library</p>
                            <h3>Saved links</h3>
                        </div>
                        <span class="count-badge">@urls.Count</span>
                    </div>
                    @if (urls.Count == 0)
                    {
                        <div class="empty-state empty-state-compact">
                            <p>Create a link to see it here.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="url-list">
                            @foreach (var url in DisplayedUrls)
                            {
                                <li>
                                    <strong><a href="@url.ShortenedUrl" target="_blank">@url.Code</a></strong>
                                    <span>@url.OriginalUrl</span>
                                </li>
                            }
                        </ul>

                        @if (!showAllUrls && urls.Count > PreviewUrlCount)
                        {
                            <button type="button" class="view-all-link" @onclick="ShowAllUrls">View all links <span aria-hidden="true">→</span></button>
                        }
                        else if (showAllUrls)
                        {
                            <div class="pagination-controls">
                                <label>
                                    Links per page
                                    <select value="@pageSize" @onchange="OnPageSizeChanged">
                                        @foreach (var option in PageSizeOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </label>
                                <div class="pagination-actions">
                                    <button type="button" class="secondary-button" @onclick="PreviousPage" disabled="@(currentPage == 1)">Previous</button>
                                    <span>Page @currentPage of @TotalPages</span>
                                    <button type="button" class="secondary-button" @onclick="NextPage" disabled="@(currentPage == TotalPages)">Next</button>
                                </div>
                            </div>
                        }
                    }
                </article>
            </section>
        }

@code {
    private readonly CreateShortUrlRequestModel request = new();
    private readonly List<ShortUrlViewModel> urls = [];
    private ShortUrlViewModel? latestLink;
    private bool isSubmitting;
    private bool isSignedIn;
    private bool urlsLoaded;
    private bool showAllUrls;
    private int currentPage = 1;
    private int pageSize = 10;
    private string clerkUserId = string.Empty;
    private string? createError;

    private const int PreviewUrlCount = 5;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private IEnumerable<ShortUrlViewModel> DisplayedUrls => showAllUrls
        ? urls.Skip((currentPage - 1) * pageSize).Take(pageSize)
        : urls.Take(PreviewUrlCount);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(urls.Count / (double)pageSize));

    [Inject]
    private UrlShortenerApiClient ApiClient { get; set; } = default!;

    private DotNetObjectReference<Home>? dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        dotNetReference = DotNetObjectReference.Create(this);

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.registerAuthStateListener", dotNetReference);
            var authState = await JSRuntime.InvokeAsync<AuthState>("urlTrimmerClerk.getAuthState");
            await ApplyAuthStateAsync(authState);
        }
        catch (JSException)
        {
            isSignedIn = false;
        }
    }

    [JSInvokable]
    public Task OnAuthStateChanged(AuthState authState) => ApplyAuthStateAsync(authState);

    private async Task ApplyAuthStateAsync(AuthState authState)
    {
        isSignedIn = authState.IsSignedIn;
        clerkUserId = authState.UserId;

        if (isSignedIn && !urlsLoaded)
        {
            urlsLoaded = true;
            var items = await ApiClient.GetUrlsAsync(clerkUserId);
            urls.Clear();
            urls.AddRange(items);
            currentPage = 1;
        }

        await InvokeAsync(StateHasChanged);
    }

    private string submitLabel => isSubmitting ? "Creating..." : "Shorten URL";

    private async Task CreateShortUrlAsync()
    {
        isSubmitting = true;
        createError = null;

        try
        {
            var created = await ApiClient.CreateAsync(new CreateShortUrlRequest(request.OriginalUrl, request.CustomCode,
clerkUserId));
            latestLink = created;
            urls.Insert(0, created);
            currentPage = 1;
            request.Reset();
        }
        catch (HttpRequestException exception)
        {
            createError = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowAllUrls()
    {
        showAllUrls = true;
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var selectedPageSize)
            && PageSizeOptions.Contains(selectedPageSize))
        {
            pageSize = selectedPageSize;
            currentPage = 1;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetReference is null)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("urlTrimmerClerk.unregisterAuthStateListener", dotNetReference);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        dotNetReference.Dispose();
        dotNetReference = null;
    }

    private sealed class CreateShortUrlRequestModel
    {
        public string OriginalUrl { get; set; } = string.Empty;

        public string? CustomCode { get; set; }

        public void Reset()
        {
            OriginalUrl = string.Empty;
            CustomCode = null;
        }
    }

    public sealed record AuthState(bool IsSignedIn, string DisplayName, string UserId);
}